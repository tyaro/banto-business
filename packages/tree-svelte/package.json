  "description": "Banto tree view: headless pure-TS core + Svelte 5 (Runes) UI — expand/collapse, single/multi selection with tri-state checkboxes, lazy loading, drag reorder, inline rename, optional columns (tree-grid) and a tree-select popover",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tyaro/banto.git",
    "directory": "packages/tree-svelte"
  },
  "type": "module",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^30.0.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^5.8.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
