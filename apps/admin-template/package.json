{
  "name": "banto-business-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy custom-banto baseLocale --emit-ts-declarations && node ../../scripts/check-i18n-nonempty.mjs",
    "predev": "pnpm paraglide:compile",
    "dev": "vite dev",
    "prebuild": "pnpm paraglide:compile",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "@banto/admin-core": "workspace:*",
    "@banto/attachments": "workspace:*",
    "@banto/charts": "workspace:*",
    "@banto/dock-svelte": "workspace:*",
    "@banto/forms": "workspace:*",
    "@banto/grid-svelte": "workspace:*",
    "@banto/report": "workspace:*",
    "@banto/theme": "workspace:*",
    "@lucide/svelte": "^1.52.0",
    "@tauri-apps/api": "^2.12.1"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-m-function-matcher": "2.2.16",
    "@inlang/plugin-message-format": "4.4.4",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.10"
  }
}
